{
  "name": "web-passion-marine",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "clean": "rimraf .next out build dist",
    "clean:hard": "rimraf .next out build dist node_modules/.cache",
    "rebuild": "npm run clean && npm run build",
    "rebuild:hard": "npm run clean:hard && npm run build",
    "rebuild:plesk": "npm run clean:hard && npm install && npm run build",
    "deploy:dev": "npm run clean && npm ci && cp .env.development .env.local && npm run build",
    "deploy:stg": "npm run clean && npm ci && cp .env.staging .env.local && npm run build",
    "deploy:prd": "npm run clean:hard && npm ci && cp .env.production .env.local && npm run build",
    "postinstall": "next telemetry disable",
    "test": "echo \"No tests specified\" && exit 0"
  },
  "dependencies": {
    "@phosphor-icons/web": "2.1.2",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-slot": "^1.0.2",
    "@types/aos": "3.0.7",
    "@types/nodemailer": "7.0.3",
    "aos": "2.3.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "lightgallery": "2.9.0",
    "lucide-react": "0.542.0",
    "next": "15.5.9",
    "nodemailer": "7.0.10",
    "prettier": "^3.0.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "react": "^19.0.0",
    "react-countup": "6.5.3",
    "react-dom": "^19.0.0",
    "rimraf": "6.0.1",
    "swiper": "12.0.2",
    "tailwind-merge": "^1.14.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.0.0",
    "@next/eslint-plugin-next": "15.5.4",
    "@tailwindcss/aspect-ratio": "0.4.2",
    "@tailwindcss/forms": "0.5.10",
    "@tailwindcss/typography": "0.5.16",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.21",
    "eslint": "9.36.0",
    "eslint-config-next": "15.5.4",
    "postcss": "^8.5.6",
    "postcss-font-display": "0.3.0",
    "sass": "^1.92.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.19.0",
    "npm": ">=10.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
