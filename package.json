{
    "name": "web-passion-marine",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "next lint",
        "lint:fix": "next lint --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "type-check": "tsc --noEmit",
        "clean": "rm -rf .next out build dist",
        "test": "echo \"No tests specified\" && exit 0",
        "test:watch": "echo \"No tests specified\" && exit 0",
        "build:development": "NODE_ENV=development next build",
        "build:staging": "NODE_ENV=staging next build",
        "build:production": "NODE_ENV=production next build",
        "deploy:development": "NODE_ENV=development npm run build && npm run start",
        "deploy:staging": "NODE_ENV=staging npm run build && npm run start",
        "deploy:production": "NODE_ENV=production npm run build && npm run start",
        "postinstall": "next telemetry disable",
        "build-css": "tailwindcss -i ./src/app/globals.css -o ./src/app/output.css --watch"
    },
    "dependencies": {
        "@phosphor-icons/web": "2.1.2",
        "@radix-ui/react-dialog": "1.1.15",
        "@radix-ui/react-slot": "^1.0.2",
        "@types/aos": "3.0.7",
        "@types/nodemailer": "7.0.3",
        "aos": "2.3.4",
        "class-variance-authority": "^0.7.0",
        "clsx": "^2.0.0",
        "eslint-config-prettier": "^9.0.0",
        "eslint-plugin-prettier": "^5.0.0",
        "lucide-react": "0.542.0",
        "next": "15.5.4",
        "nodemailer": "7.0.10",
        "prettier": "^3.0.0",
        "prettier-plugin-tailwindcss": "^0.6.0",
        "react": "^19.0.0",
        "react-countup": "6.5.3",
        "react-dom": "^19.0.0",
        "swiper": "12.0.2",
        "tailwind-merge": "^1.14.0"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.0.0",
        "@next/eslint-plugin-next": "15.5.4",
        "@tailwindcss/aspect-ratio": "0.4.2",
        "@tailwindcss/forms": "0.5.10",
        "@tailwindcss/typography": "0.5.16",
        "@types/node": "^22.0.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "autoprefixer": "^10.4.21",
        "eslint": "9.36.0",
        "eslint-config-next": "15.5.4",
        "postcss": "^8.5.6",
        "sass": "^1.92.1",
        "tailwindcss": "^3.4.17",
        "typescript": "^5.7.0"
    },
    "engines": {
        "node": ">=22.19.0",
        "npm": ">=10.0.0"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    }
}
