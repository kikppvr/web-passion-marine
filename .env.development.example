# Copy to .env.development on the dev server (not committed).
# Used by: npm run deploy:dev (copies to .env.local before build)

NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SITE_URL=https://dev.passionmarine.co.th

# SMTP (contact form) — set real values on the server
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=info@passionmarine.co.th
