@use "../../base/image" as image;
@use "../../base/_font-mixins" as fonts;
@use "../../base/_base" as base;

// Mission Card Component Styles
.card-mission {
    position: relative;
    background-color: var(--white);
    overflow: hidden;
    width: 100%;
    height: 100%;
    // display: flex;
    // flex-direction: column;
    border-radius: 5px;
    transition: all 0.3s ease-in-out;
    cursor: pointer;

    // Image Container
    .card-mission__image-container {
        position: relative;
        width: 100%;
        overflow: hidden;
        border-radius: 5px;
        @include image.baseRatioImg(140%);

        @include base.media-down(mobile) {
            @include image.baseRatioImg(130%);
        }

        .card-mission__image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
            border: 0;
        }

        .card-mission__overlay {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 100%;
            background: var(--blue-500);
            opacity: 0;
        display: block;
            z-index: 2;
            transition: all 0.3s ease-in-out;
        }
    }

    // Content Section
    .card-mission__content {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 100%;
        z-index: 3;
        overflow: hidden;

        .card-mission__content-inner {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            padding: 24px;
            display: flex;
            flex-direction: column;
            gap: 16px;
            transform: translateY(0);
            transition: transform 0.3s ease-in-out;

            @include base.media-down(laptop) {
                padding: 20px;
                gap: 12px;
            }

            @include base.media-down(mobile) {
                padding: 16px;
                gap: 8px;
            }
        }
    }

    // Title Section
    .card-mission__title {
        font-size: var(--text-h5);
        font-weight: var(--font-semibold);
        line-height: 1.3;
        color: var(--text-white);
        margin: 0;
        display: block;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    // Description Section
    .card-mission__description {
        font-size: var(--text-body);
        font-weight: var(--font-normal);
        line-height: 1.4;
        color: var(--text-white);
        margin: 0;
        opacity: 0;
        display: block;
        transform: translateY(20px);
        transition: all 0.3s ease-in-out;
    }

    // Hover Effects
    &:hover {
        .card-mission__overlay {
            opacity: 1;
        }

        .card-mission__content-inner {
            transform: translateY(-20px);
        }

        .card-mission__description {
            opacity: 1;
            transform: translateY(0);
        }
    }
}
