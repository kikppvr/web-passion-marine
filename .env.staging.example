# Copy to .env.staging on the staging server (not committed).
# Used by: npm run deploy:stg (copies to .env.local before build)

NEXT_PUBLIC_APP_ENV=staging
NEXT_PUBLIC_SITE_URL=https://stg.passionmarine.co.th

# SMTP (contact form) — set real values on the server
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=info@passionmarine.co.th
